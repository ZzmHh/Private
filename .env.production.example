PORT=8787

# 必须换成生产环境随机长密钥，用于登录 Token 签名。
JWT_SECRET=replace_with_a_long_random_secret

# OpenClaw 与网站部署在同一台 VPS 时：
# - 如果 OpenClaw 直接跑在 VPS 主机上，Docker 容器内用 host.docker.internal 访问主机。
# - 如果网站不使用 Docker、直接跑在主机上，可以改回 http://localhost:18789。
OPENCLAW_PROVIDER_NAME=OpenClaw
OPENCLAW_BASE_URL=http://host.docker.internal:18789
OPENCLAW_MODEL=openclaw
OPENCLAW_API_KEY=replace_with_openclaw_api_key

# Docker 镜像内已经配置好 Python 路径，通常不用改。
PYTHON_COMMAND=/opt/venv/bin/python

# 邮箱验证码发送配置。生产环境必须配置真实 SMTP，避免用户无法收验证码。
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=replace_with_email_smtp_password
SMTP_FROM="凡梦AI <your_email@example.com>"

# TikTok Shop OAuth（与 .env.example 一致；生产必须配置公网回调与前端地址）
# TIKTOK_SHOP_APP_KEY=
# TIKTOK_SHOP_APP_SECRET=
# TIKTOK_SHOP_OAUTH_REDIRECT_URI=https://你的域名/api/store/tiktok/oauth/callback
# APP_PUBLIC_URL=https://你的域名

# 前端 · 插件安装页（生产）
# VITE_PUBLIC_API_URL=https://你的域名
# VITE_PUBLIC_APP_URL=https://你的域名
# VITE_EXTENSION_CWS_URL=https://chrome.google.com/webstore/detail/你的扩展ID
# VITE_EXTENSION_ZIP_URL=/downloads/fanmeng-tiktok-extension.zip
# VITE_EXTENSION_PRIVACY_URL=https://你的域名/privacy-extension.html

# 插件 ZIP 打包：复制 extension/build.env.example → extension/build.env 后 npm run build:extension
# TIKTOK_OAUTH_STATE_SECRET=与 JWT_SECRET 独立的长随机串（多实例需一致）
