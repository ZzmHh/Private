# 生产插件打包配置（复制为 extension/build.env 后执行 npm run build:extension）
# 凡梦 API 公网地址（卖家插件弹窗默认填入，勿带末尾斜杠）
EXTENSION_DEFAULT_API_BASE=https://你的域名

# Chrome 网上应用店链接（上架后填写，可留空）
VITE_EXTENSION_CWS_URL=

# 网站根地址（教程/隐私链引用）
EXTENSION_WEBSITE_URL=https://你的域名

# 隐私政策页（可填 https://你的域名/privacy-extension.html）
EXTENSION_PRIVACY_URL=https://你的域名/privacy-extension.html
