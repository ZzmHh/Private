PORT=8787

# 运营后台管理员邮箱，逗号分隔；重启服务后同步 isAdmin（见 server/db.js syncAdminFlagsFromEnv）
# ADMIN_EMAILS=your_admin@example.com

# OpenClaw 如果兼容 OpenAI Chat Completions，可直接填这里。
# 如果你的 OpenClaw 后台给的是其他地址，把 BASE_URL 改成它的 /v1 地址。
OPENCLAW_PROVIDER_NAME=OpenClaw
OPENCLAW_BASE_URL=https://api.openai.com/v1
OPENCLAW_MODEL=openclaw
OPENCLAW_API_KEY=your_openclaw_api_key_here

# 邮箱验证码发送配置。未配置时，本地开发会在页面显示测试验证码。
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_smtp_password
SMTP_FROM="凡梦AI <your_email@example.com>"

# TikTok Shop Open API（签名仅在服务端计算）
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
# OAuth：与 Partner Center「回调 URL」完全一致（卖家授权后 TikTok 浏览器跳转至此）
# 分步图文说明见仓库 docs/TIKTOK_SHOP_OAUTH_SETUP.md
# TIKTOK_SHOP_OAUTH_REDIRECT_URI=https://你的域名/api/store/tiktok/oauth/callback
# 授权完成后的浏览器地址（前端 SPA；本地开发常为 Vite 端口，与 API 分离）
# 插件「去网站订阅」也会使用该地址 + /#subscription
# APP_PUBLIC_URL=http://127.0.0.1:5173

# 前端 · 插件安装引导（Vite 构建时注入，见 docs/EXTENSION_INSTALL.md）
# VITE_PUBLIC_API_URL=http://127.0.0.1:8787
# VITE_PUBLIC_APP_URL=http://127.0.0.1:5173
# VITE_EXTENSION_CWS_URL=
# VITE_EXTENSION_ZIP_URL=/downloads/fanmeng-tiktok-extension.zip
# VITE_EXTENSION_PRIVACY_URL=/privacy-extension.html
# 授权 authorize 页策略：authv2（默认，auth.tiktok-shops.com）| open（services.tiktokshop.com/open/authorize）
# TIKTOK_SHOP_OAUTH_FLOW=authv2
# open 流美区可将 TIKTOK_SHOP_AUTH_HOST=https://services.us.tiktokshop.com，或与 App 所在区域一致
# TIKTOK_SHOP_SERVICE_ID=
# state 参数 HMAC 密钥（多实例部署务必固定一致）；默认回落为 TIKTOK_SHOP_APP_SECRET
# TIKTOK_OAUTH_STATE_SECRET=
# TIKTOK_SHOP_BASE_URL=https://open-api.tiktokglobalshop.com
# TIKTOK_SHOP_API_VERSION=202309

# 买家消息自动话术 → 出站 API（路径以 Partner 文档为准，可用环境变量覆盖）
# TIKTOK_SHOP_CS_SEND_PATH_TEMPLATE=/customer_service/{version}/conversations/{conversation_id}/messages
# 生产联调前建议：仅生成话术不真实发送
# TIKTOK_CS_SEND_DRY_RUN=1
# Webhook 只处理这些事件名子串（逗号分隔）
# TIKTOK_WEBHOOK_EVENT_TYPES=NEW_MESSAGE,MESSAGE,IM_MESSAGE,IM
