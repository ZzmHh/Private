PORT=8787

# 运营后台管理员邮箱，逗号分隔；重启服务后同步 isAdmin（见 server/db.js syncAdminFlagsFromEnv）
# ADMIN_EMAILS=your_admin@example.com

# OpenClaw 如果兼容 OpenAI Chat Completions，可直接填这里。
# 如果你的 OpenClaw 后台给的是其他地址，把 BASE_URL 改成它的 /v1 地址。
OPENCLAW_PROVIDER_NAME=OpenClaw
OPENCLAW_BASE_URL=https://api.openai.com/v1
OPENCLAW_MODEL=openclaw
OPENCLAW_API_KEY=your_openclaw_api_key_here

# 邮箱验证码发送配置。未配置时，本地开发会在页面显示测试验证码。
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_smtp_password
SMTP_FROM="凡梦AI <your_email@example.com>"

# TikTok Shop Open API（签名仅在服务端计算）
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
# TIKTOK_SHOP_BASE_URL=https://open-api.tiktokglobalshop.com
# TIKTOK_SHOP_API_VERSION=202309

# 买家消息自动话术 → 出站 API（路径以 Partner 文档为准，可用环境变量覆盖）
# TIKTOK_SHOP_CS_SEND_PATH_TEMPLATE=/customer_service/{version}/conversations/{conversation_id}/messages
# 生产联调前建议：仅生成话术不真实发送
# TIKTOK_CS_SEND_DRY_RUN=1
# Webhook 只处理这些事件名子串（逗号分隔）
# TIKTOK_WEBHOOK_EVENT_TYPES=NEW_MESSAGE,MESSAGE,IM_MESSAGE,IM
