PORT=8787

# OpenClaw 如果兼容 OpenAI Chat Completions，可直接填这里。
# 如果你的 OpenClaw 后台给的是其他地址，把 BASE_URL 改成它的 /v1 地址。
OPENCLAW_PROVIDER_NAME=OpenClaw
OPENCLAW_BASE_URL=https://api.openai.com/v1
OPENCLAW_MODEL=openclaw
OPENCLAW_API_KEY=your_openclaw_api_key_here

# 邮箱验证码发送配置。未配置时，本地开发会在页面显示测试验证码。
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_smtp_password
SMTP_FROM="凡梦AI <your_email@example.com>"
